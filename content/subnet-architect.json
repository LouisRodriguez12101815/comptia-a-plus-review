  "concepts": [
    {
      "id": "ipv4-bits",
      "prompt": "An IPv4 address has four octets. How many bits does it contain?",
      "choices": [
        {
          "id": "32",
          "label": "32 bits",
          "correct": true,
          "explanation": "Four octets \u00d7 8 bits = 32. The prefix counts network bits out of those 32."
        },
        {
          "id": "128",
          "label": "128 bits",
          "correct": false,
          "explanation": "128 bits describes IPv6; these missions use IPv4."
        }
      ],
      "sourceIds": [
        "chapter7",
        "lab01"
      ]
    },
    {
      "id": "rfc1918",
      "prompt": "Which range is RFC 1918 private space suitable for this internal design?",
      "choices": [
        {
          "id": "172-private",
          "label": "172.16.0.0/12",
          "correct": true,
          "explanation": "RFC 1918 reserves 10/8, 172.16/12 and 192.168/16. Not all 172.x addresses are private."
        },
        {
          "id": "all-172",
          "label": "All of 172.0.0.0/8",
          "correct": false,
          "explanation": "Only 172.16.0.0 through 172.31.255.255 is RFC 1918 private in the 172 range."
        }
      ],
      "sourceIds": [
        "chapter7",
        "rfc1918"
      ]
    },
    {
      "id": "apipa",
      "prompt": "A host self-assigns 169.254.12.8. Which scope best describes this APIPA address?",
      "choices": [
        {
          "id": "link-local",
          "label": "IPv4 link-local, not routed to another subnet",
          "correct": true,
          "explanation": "169.254/16 is link-local. Investigate automatic configuration/DHCP in the scenario; it is not an RFC 1918 routed address plan."
        },
        {
          "id": "public",
          "label": "A public Internet destination",
          "correct": false,
          "explanation": "APIPA is link-local; routers must not forward IPv4 link-local traffic between links."
        }
      ],
      "sourceIds": [
        "chapter7",
        "rfc3927"
      ]
    },
    {
      "id": "loopback",
      "prompt": "Which address is used to test this host\u2019s local IP stack, not a path to another host?",
      "choices": [
        {
          "id": "local",
          "label": "127.0.0.1 loopback",
          "correct": true,
          "explanation": "127/8 is loopback and stays inside the host. A loopback response does not verify a LAN or router path."
        },
        {
          "id": "gateway",
          "label": "172.16.8.1 gateway",
          "correct": false,
          "explanation": "A gateway test exercises an external local path. It is not the host\u2019s loopback address."
        }
      ],
      "sourceIds": [
        "chapter7",
        "rfc1122"
      ]
    },
    {
      "id": "cidr-vlsm",
      "prompt": "Why use different prefixes for LANs with different requirements?",
      "choices": [
        {
          "id": "conserve",
          "label": "VLSM allocates appropriately sized blocks; CIDR writes address/prefix without default classes",
          "correct": true,
          "explanation": "CIDR notation expresses a prefix. Equal-size subnetting uses one child prefix; VLSM mixes prefixes to match needs and conserve addresses."
        },
        {
          "id": "same",
          "label": "CIDR and VLSM both require every LAN to have the same size",
          "correct": false,
          "explanation": "They are related but different ideas. VLSM deliberately allows different block sizes."
        }
      ],
      "sourceIds": [
        "chapter7",
        "lab01"
      ]
    }
  ],
