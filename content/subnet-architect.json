  "optionalIpv6": [
    {
      "id": "ipv6-width",
      "prompt": "Separate review: how wide is an IPv6 address?",
      "choices": [
        {
          "id": "128",
          "label": "128 bits",
          "explanation": "Correct: IPv6 has 128-bit addresses (RFC 4291). These IPv4 game calculations use 32 bits and do not apply IPv4 network/broadcast reservations to IPv6.",
          "correct": true
        },
        {
          "id": "32",
          "label": "32 bits",
          "explanation": "32 bits is IPv4, not IPv6. Keep the address families and their allocation rules separate.",
          "correct": false
        }
      ],
      "sourceIds": [
        "rfc4291"
      ]
    },
    {
      "id": "dual-stack",
      "prompt": "Which approach lets a node support both IPv4 and IPv6 protocol stacks?",
      "choices": [
        {
          "id": "dual",
          "label": "Dual stack",
          "explanation": "Correct: dual-stack nodes support both families (RFC 4213). This review is separate from the IPv4/VLSM mission.",
          "correct": true
        },
        {
          "id": "only4",
          "label": "IPv4-only configuration",
          "explanation": "An IPv4-only node does not supply an IPv6 stack. Dual stack supports both; translation and tunneling are different mechanisms.",
          "correct": false
        }
      ],
      "sourceIds": [
        "rfc4213"
      ]
    }
  ],
