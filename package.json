{
  "name": "comptia-a-plus-review",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:game": "node --import ./tests/register.mjs --test --test-isolation=none tests/outage-ops-*.test.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:game && npm run test:practice && npm run test:subnet && npm run test:content && npm run test:rubric-audit && npm run test:report && npm run test:objectives && npm run test:exam && npm run audit:visuals -- --check",
    "test:e2e": "node --import ./tests/register.mjs scripts/verify-outage-ops-e2e.mjs",
    "test:practice": "node --import ./tests/register.mjs --test --test-isolation=none tests/practice-*.test.mjs",
    "test:e2e:practice": "node --import ./tests/register.mjs scripts/verify-practice-games.mjs",
    "test:e2e:learning": "node --import ./tests/register.mjs scripts/verify-learning-loop.mjs",
    "test:subnet": "python3 scripts/verify-subnet-fixtures.py && node --import ./tests/register.mjs --test --test-isolation=none tests/subnet-*.test.mjs",
    "test:e2e:subnet": "node --import ./tests/register.mjs scripts/verify-subnet-games.mjs",
    "check:content": "node scripts/check-content.mjs",
    "test:content": "node --test --test-isolation=none tests/content-check.test.mjs",
    "audit:rubric": "python3 tools/rubric-audit/scripts/run.py",
    "test:rubric-audit": "python3 -m unittest discover -s tools/rubric-audit/tests",
    "test:report": "node --import ./tests/register.mjs --test --test-isolation=none tests/report-issue.test.mjs",
    "test:a11y": "node scripts/verify-a11y.mjs",
    "report:objectives": "node scripts/objective-coverage.mjs",
    "test:objectives": "node --test --test-isolation=none tests/objectives.test.mjs",
    "test:exam": "node --test --test-isolation=none tests/exam-test.test.mjs",
    "audit:visuals": "node scripts/audit-visuals.mjs",
    "test:e2e:objectives": "node scripts/verify-objective-dashboard.mjs",
    "audit:rubric:openai": "tools/rubric-audit-openai/.venv/bin/python -m rubric_audit_openai",
    "test:rubric:openai": "tools/rubric-audit-openai/.venv/bin/python -m unittest discover -s tools/rubric-audit-openai/tests -v",
    "demo:rubric:openai": "tools/rubric-audit-openai/.venv/bin/python -m rubric_audit_openai demo --engine langgraph"
  },
  "dependencies": {
    "next": "16.3.5",
    "next-intl": "^4.14.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ts-fsrs": "5.4.2",
    "twilio": "6.1.2",
    "twilio-sync": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright": "1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
