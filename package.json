{
  "name": "comptia-a-plus-review",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "export:learner-activity": "node --import ./tests/register.mjs scripts/export-learner-activity.mjs",
    "test:learner-activity": "node --import ./tests/register.mjs --test tests/learner-activity.test.mjs",
    "test:protected-learner-activity": "node --import ./tests/register.mjs --test tests/protected-learner-activity.test.mjs",
    "test:game": "node --import ./tests/register.mjs --test tests/outage-ops-*.test.mjs",
    "test:weak-areas": "node --import ./tests/register.mjs --test tests/weak-areas.test.mjs",
    "test:controlled-pool": "node --import ./tests/register.mjs --test tests/controlled-question-pool.test.mjs",
    "audit:n10-question-objectives": "node scripts/audit-n10-question-objectives.mjs",
    "test:n10-objective-mapping": "node --test tests/n10-objective-mapping.test.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:game && npm run test:weak-areas && npm run test:controlled-pool && npm run test:n10-objective-mapping && npm run test:quiz-feedback && npm run test:inline-remediation && npm run test:telemetry && npm run test:performance && npm run test:practice && npm run test:subnet && npm run test:content && npm run test:rubric-audit && npm run test:report && npm run test:learner && npm run test:objectives && npm run test:exam && npm run test:aws-mixed-feedback && npm run test:aws-domain-experience && npm run test:video && npm run test:concept-videos && npm run test:concepts && npm run test:sad-visuals && npm run audit:visuals -- --check",
    "test:e2e": "node --import ./tests/register.mjs scripts/verify-outage-ops-e2e.mjs",
    "test:practice": "node --import ./tests/register.mjs --test tests/practice-*.test.mjs",
    "test:e2e:practice": "node --import ./tests/register.mjs scripts/verify-practice-games.mjs",
    "test:e2e:weak-areas": "node scripts/verify-weak-areas.mjs",
    "test:e2e:learning": "node --import ./tests/register.mjs scripts/verify-learning-loop.mjs",
    "test:subnet": "python3 scripts/verify-subnet-fixtures.py && node --import ./tests/register.mjs --test tests/subnet-*.test.mjs",
    "test:e2e:subnet": "node --import ./tests/register.mjs scripts/verify-subnet-games.mjs",
    "check:content": "node scripts/check-content.mjs",
    "test:content": "node --test tests/content-check.test.mjs",
    "audit:rubric": "python3 tools/rubric-audit/scripts/run.py",
    "test:rubric-audit": "python3 -m unittest discover -s tools/rubric-audit/tests",
    "test:learner": "node --import ./tests/register.mjs --test tests/learner-sync.test.mjs tests/learner-sync-response.test.mjs tests/learner-progress-store.test.mjs tests/export-primary-history.test.mjs tests/learner-activity.test.mjs tests/protected-learner-activity.test.mjs",
    "test:report": "node --import ./tests/register.mjs --test tests/report-issue.test.mjs",
    "test:a11y": "node scripts/verify-a11y.mjs",
    "report:objectives": "node scripts/objective-coverage.mjs",
    "test:objectives": "node --test tests/objectives.test.mjs",
    "test:exam": "node --test tests/exam-test.test.mjs tests/aws-review.test.mjs tests/aws-domain4-reaudit.test.mjs tests/aws-domain1-benefits-economics.test.mjs tests/aws-mixed-practice.test.mjs",
    "test:aws-domain4-reaudit": "node --test tests/aws-domain4-reaudit.test.mjs",
    "test:aws-domain1-benefits-economics": "node --test tests/aws-domain1-benefits-economics.test.mjs",
    "test:aws-mixed-feedback": "node --import ./tests/register.mjs --test tests/aws-mixed-practice-feedback.test.mjs",
    "test:aws-domain-experience": "node --import ./tests/register.mjs --test tests/aws-domain-quiz-experience.test.mjs",
    "audit:visuals": "node scripts/audit-visuals.mjs",
    "test:e2e:objectives": "node scripts/verify-objective-dashboard.mjs",
    "audit:rubric:openai": "tools/rubric-audit-openai/.venv/bin/python -m rubric_audit_openai",
    "test:rubric:openai": "tools/rubric-audit-openai/.venv/bin/python -m unittest discover -s tools/rubric-audit-openai/tests -v",
    "demo:rubric:openai": "tools/rubric-audit-openai/.venv/bin/python -m rubric_audit_openai demo --engine langgraph",
    "test:video": "node --test tests/video-captions.test.mjs",
    "test:sad-visuals": "node --test tests/sad-visuals.test.mjs",
    "build:sad-visuals": "node tools/sad-visuals/build.mjs",
    "audit:concept-notes": "node scripts/audit-concept-notes.mjs",
    "test:concepts": "node --import ./tests/register.mjs --test tests/network-concepts.test.mjs",
    "test:concept-videos": "node --test tests/concept-videos.test.mjs",
    "test:quiz-feedback": "node --import ./tests/register.mjs --test tests/quiz-feedback.test.mjs",
    "test:inline-remediation": "node --import ./tests/register.mjs --test tests/inline-remediation.test.mjs",
    "test:telemetry": "node --import ./tests/register.mjs --test tests/study-telemetry.test.mjs",
    "test:performance": "node --import ./tests/register.mjs --test tests/learner-performance.test.mjs tests/question-telemetry-v2.test.mjs",
    "test:e2e:quiz-feedback": "node scripts/verify-quiz-feedback.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "next": "16.4.6",
    "next-intl": "^4.14.9",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "ts-fsrs": "5.4.2",
    "twilio": "6.1.2",
    "twilio-sync": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright": "1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
